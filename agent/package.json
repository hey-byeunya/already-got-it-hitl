      "default": "./dist/src/limits.js"
    },
    "./tools": {
      "types": "./dist/src/tools.d.ts",
      "default": "./dist/src/tools.js"
    },
    "./env": {
      "types": "./dist/src/env.d.ts",
      "default": "./dist/src/env.js"
    },
    "./publish": {
      "types": "./dist/src/publish.d.ts",
