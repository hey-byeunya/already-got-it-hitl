# 실제 값을 넣은 파일은 .env.local 이며 저장소에 넣지 않는다 (.gitignore 에 있다).
# 이 파일은 형식만 담는다.

# ── 실행 엔진 ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── 도구 (live 모드에서만 필요) ─────────────────────────────
# 읽기 전용 토큰
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# fine-grained 토큰: Issues 읽기·쓰기 + Contents · Pull requests **읽기**. 저장소 쓰기·삭제 권한은 주지 않는다
# (커밋 · PR 읽기가 없으면 live 에서 개발 활동 조회가 403 으로 실패해 발행 게이트가 매주 tool_failed 로 멈춘다)
GITHUB_TOKEN=
# 공개 가능한 두 값. service_role 키는 어디에도 쓰지 않는다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 실행 모드와 권한 범위 ──────────────────────────────────
# fixture : 외부 API 를 부르지 않고 fixtures/snapshots 를 읽는다 (평가·캡처 재현용, 기본값)
# live    : 실제 Vercel·Supabase·GitHub 을 부른다
OPS_MODE=fixture
OPS_FIXTURE_ID=f2-deploy-fail
GITHUB_ALLOWED_REPOS=hey-byeunya/already-got-it
# 선택 — 이슈에 붙일 수 있는 라벨 목록, 승인 토큰 유효 초 (기본 600)
# GITHUB_ALLOWED_LABELS=ops,bug,enhancement,question
# OPS_APPROVAL_TTL=600

# ── live 모드에서만 필요한 것 ────────────────────────────────
# 집계 RPC 를 부를 때 함께 보내는 비밀값
# supabase/ops_metrics.sql 안의 값과 **같아야** 한다 (직접 정한 긴 임의 문자열).
# anon 키는 브라우저로 내려가는 공개 값이라, 이 토큰이 없으면 anon 키를 가진
# 누구나 전체 가입자 수를 읽을 수 있다 (DECISIONS.md D20).
OPS_METRICS_TOKEN=

# 실제 GitHub 이슈를 **만들고 닫는** 스위치 
# 0 : 꺼짐, 기본값
# 1 : 켜짐
# 사람의 승인(게이트 ①②③)과는 다른 질문이다
#   승인                  = "이 이슈 내용이 맞다"
#   OPS_ALLOW_LIVE_WRITES = "실제 공개 저장소를 바꿔도 된다"
# live 로 읽기만 돌려 보는 동안 실수로 실제 이슈가 생기지 않게 꺼 둔다.
OPS_ALLOW_LIVE_WRITES=0

# ── 슬랙 발행 (발행 게이트, DECISIONS.md D37~D39) ─────────────
# 슬랙 앱의 Incoming Webhooks 에서 **채널**을 골라 만든 주소 (앱 DM 용은 messages_tab_disabled 로 거절된다).
# **비밀값이다** — 공개 저장소에 올라가면
# 슬랙이 찾아내 폐기한다. 웹훅으로 보낸 메시지는 지울 수 없다.
SLACK_WEBHOOK_URL=
# 1 : 보내지 않고 runs/{id}/slack-dryrun.json 에 보낼 내용만 남긴다 (기본값)
# 0 : 실제로 보낸다. SLACK_WEBHOOK_URL 이 있어야 한다. 보낼 때마다 다시 읽으니 서버 재시작은 필요 없다
PUBLISH_DRY_RUN=1
